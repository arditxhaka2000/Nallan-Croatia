@{
    ViewBag.Title = "Uvjeti prodaje - NALLAN.HR";
    Layout = "_Layout";
    var sharedRes = (Dictionary<string, string>)ViewData["Shared"];
}

<style>
    .legal-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 40px 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .legal-header {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        padding: 40px;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 40px;
    }

        .legal-header h1 {
            font-size: 2.5rem;
            margin: 0;
            font-weight: 700;
        }

        .legal-header p {
            font-size: 1.1rem;
            margin: 10px 0 0 0;
            opacity: 0.9;
        }

    .legal-content {
        background: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        line-height: 1.8;
    }

    .legal-section {
        margin-bottom: 40px;
    }

        .legal-section h2 {
            color: #dc3545;
            font-size: 1.8rem;
            margin-bottom: 20px;
            border-bottom: 2px solid #dc3545;
            padding-bottom: 10px;
        }

        .legal-section h3 {
            color: #333;
            font-size: 1.4rem;
            margin: 25px 0 15px 0;
        }

        .legal-section p {
            margin-bottom: 15px;
            color: #555;
        }

        .legal-section ul {
            margin: 15px 0;
            padding-left: 25px;
        }

        .legal-section li {
            margin-bottom: 8px;
            color: #555;
        }

    .company-info {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin: 30px 0;
        border-left: 4px solid #dc3545;
    }

        .company-info strong {
            color: #dc3545;
        }

    .effective-date {
        text-align: center;
        color: #666;
        font-style: italic;
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }

    @@media (max-width: 768px) {
        .legal-container {
            padding: 20px 10px;
        }

        .legal-header {
            padding: 30px 20px;
        }

            .legal-header h1 {
                font-size: 2rem;
            }

        .legal-content {
            padding: 30px 20px;
        }
    }
</style>

<div class="legal-container">
    <div class="legal-header">
        <h1>@sharedRes.CheckKey("TermsOfSale")</h1>
        <p>NALLAN.HR - Gianna Shoes d.o.o.</p>
    </div>

    <div class="legal-content">
        <div class="company-info">
            <strong>Gianna Shoes d.o.o.</strong><br>
            Samoborska cesta 145, 10000 Zagreb, @sharedRes.CheckKey("Croatia")<br>
            OIB: 27743781662<br>
            @sharedRes.CheckKey("CommercialCourt")<br>
            @sharedRes.CheckKey("Email"): hello@nallan.hr<br>
            @sharedRes.CheckKey("Phone"): +385 989 968 721
        </div>

        <div class="legal-section">
            <h2>@sharedRes.CheckKey("TOSSection1")</h2>
            <p><strong>@sharedRes.CheckKey("Buyer")</strong> - @sharedRes.CheckKey("BuyerDesc")</p>
            <p><strong>@sharedRes.CheckKey("Seller")</strong> - @sharedRes.CheckKey("SellerDesc")</p>
            <p><strong>@sharedRes.CheckKey("Recipient")</strong> - @sharedRes.CheckKey("RecipientDesc")</p>
            <p>@sharedRes.CheckKey("BuyerResponsibility")</p>
        </div>

        <div class="legal-section">
            <h2>@sharedRes.CheckKey("TOSSection2")</h2>
            <p>@sharedRes.CheckKey("LegalCapacityDesc")</p>
        </div>

        <div class="legal-section">
            <h2>@sharedRes.CheckKey("TOSSection3")</h2>
            <p>@sharedRes.CheckKey("ProductPricesIntro")</p>
            <ul>
                <li>@sharedRes.CheckKey("PricesInEuro")</li>
                <li>@sharedRes.CheckKey("CompanyInVAT")</li>
                <li>@sharedRes.CheckKey("ShippingCostSeparate")</li>
            </ul>
        </div>

        <div class="legal-section">
            <h2>@sharedRes.CheckKey("TOSSection4")</h2>
            <p>@sharedRes.CheckKey("OrderContractIntro")</p>
            <h3>@sharedRes.CheckKey("PaymentMethods"):</h3>
            <ul>
                <li>@sharedRes.CheckKey("CashOnDelivery")</li>
                <li>@sharedRes.CheckKey("CardPaymentCorvus")</li>
            </ul>
            <p>@sharedRes.CheckKey("OrderConfirmation")</p>
        </div>

        <div class="legal-section">
            <h2>@sharedRes.CheckKey("TOSSection5")</h2>
            <p>@sharedRes.CheckKey("ProductDeliveryIntro")</p>
            <h3>@sharedRes.CheckKey("DeliveryCroatia"):</h3>
            <ul>
                <li>@sharedRes.CheckKey("OrderProcessing")</li>
                <li>@sharedRes.CheckKey("DeliveryTimeframe")</li>
                <li>@sharedRes.CheckKey("ShippingCost")</li>
                <li>@sharedRes.CheckKey("FreeShipping")</li>
            </ul>
            <p>@sharedRes.CheckKey("DeliveryObligation")</p>
            <p><strong>@sharedRes.CheckKey("NoPersonalPickup")</strong></p>
        </div>

        <div class="legal-section">
            <h2>@sharedRes.CheckKey("TOSSection6")</h2>
            <p>@sharedRes.CheckKey("DefectiveShipments")</p>
            <p>@sharedRes.CheckKey("BuyerObligationCheck")</p>
            <p>@sharedRes.CheckKey("DamagedShipmentAdvice")</p>
        </div>

        <div class="legal-section">
            <h2>@sharedRes.CheckKey("TOSSection7")</h2>
            <p>@sharedRes.CheckKey("ComplaintsReturnIntro")</p>
            <ul>
                <li>@sharedRes.CheckKey("WrongOrder")</li>
                <li>@sharedRes.CheckKey("UnorderedProduct")</li>
            </ul>
            <p>@sharedRes.CheckKey("ComplaintsSentTo"):</p>
            <ul>
                <li>@sharedRes.CheckKey("ComplaintsEmail")</li>
                <li>@sharedRes.CheckKey("ComplaintsPostal")</li>
            </ul>
            <p>@sharedRes.CheckKey("ComplaintsResponse")</p>
        </div>

        <div class="legal-section">
            <h2>@sharedRes.CheckKey("TOSSection8")</h2>
            <p>@sharedRes.CheckKey("TerminationRightIntro")</p>
            <h3>@sharedRes.CheckKey("NoTerminationRight"):</h3>
            <ul>
                <li>@sharedRes.CheckKey("SealedGoods")</li>
                <li>@sharedRes.CheckKey("MixedGoods")</li>
                <li>@sharedRes.CheckKey("PerishableGoods")</li>
            </ul>
            <p>@sharedRes.CheckKey("TerminationNotification")</p>
            <p>@sharedRes.CheckKey("RefundPeriod")</p>
        </div>

        <div class="legal-section">
            <h2>@sharedRes.CheckKey("TOSSection9")</h2>
            <p>@sharedRes.CheckKey("OnlineDisputeResolution")</p>
            <p><a href="https://ec.europa.eu/consumers/odr/" target="_blank" class="text-primary">https://ec.europa.eu/consumers/odr/</a></p>
        </div>

        <div class="legal-section">
            <h2>@sharedRes.CheckKey("TOSSection10")</h2>
            <p>@sharedRes.CheckKey("FinalProvisions1")</p>
            <p>@sharedRes.CheckKey("FinalProvisions2")</p>
            <p>@sharedRes.CheckKey("FinalProvisions3")</p>
        </div>

        <div class="effective-date">
            <p>@sharedRes.CheckKey("TOSEffectiveDate")</p>
            <p>@sharedRes.CheckKey("TOSLastUpdated")</p>
        </div>
    </div>
</div>