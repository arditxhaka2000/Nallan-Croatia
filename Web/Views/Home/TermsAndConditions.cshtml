@{
    ViewData["Title"] = "Politika povrata";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentLanguage = ViewData["lang"]?.ToString() ?? "hr";
    var sharedRes = (Dictionary<string, string>)ViewData["Shared"];
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h1 class="h3 mb-0">@sharedRes.CheckKey("ReturnPolicy")</h1>
                </div>
                <div class="card-body p-4">

                    <section class="mb-5">
                        <h2 class="h4 text-warning mb-3">@sharedRes.CheckKey("GeneralInformation")</h2>
                        <p class="lead">@sharedRes.CheckKey("ReturnPolicyIntro")</p>
                        <div class="alert alert-info">
                            <i class="fa fa-info-circle me-2"></i>
                            <strong>@sharedRes.CheckKey("Important"):</strong> @sharedRes.CheckKey("ReturnPolicyLegal")
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 text-warning mb-3">@sharedRes.CheckKey("ReturnRight14Days")</h2>
                        <div class="row">
                            <div class="col-md-8">
                                <p>@sharedRes.CheckKey("ReturnRightDescription")</p>
                                <h5>@sharedRes.CheckKey("ReturnConditions"):</h5>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item"><i class="fa fa-check text-success me-2"></i>@sharedRes.CheckKey("ProductUnused")</li>
                                    <li class="list-group-item"><i class="fa fa-check text-success me-2"></i>@sharedRes.CheckKey("OriginalPackaging")</li>
                                    <li class="list-group-item"><i class="fa fa-check text-success me-2"></i>@sharedRes.CheckKey("LabelsIntact")</li>
                                    <li class="list-group-item"><i class="fa fa-check text-success me-2"></i>@sharedRes.CheckKey("ReceiptIncluded")</li>
                                </ul>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <i class="fa fa-clock-o fa-3x text-warning mb-3"></i>
                                        <h5>@sharedRes.CheckKey("14Days")</h5>
                                        <p class="small">@sharedRes.CheckKey("ReturnWithoutReason")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 text-warning mb-3">@sharedRes.CheckKey("ReturnProcedure")</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0">@sharedRes.CheckKey("Step1Contact")</h5>
                                    </div>
                                    <div class="card-body">
                                        <p>@sharedRes.CheckKey("ContactUsVia"):</p>
                                        <ul>
                                            <li><strong>@sharedRes.CheckKey("Email"):</strong> <a href="mailto:hello@nallan.hr">hello@@nallan.hr</a></li>
                                            <li><strong>@sharedRes.CheckKey("Phone"):</strong> +385 98 996 8721</li>
                                        </ul>
                                        <p class="small text-muted">@sharedRes.CheckKey("ResponseTime24h")</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-success text-white">
                                        <h5 class="mb-0">@sharedRes.CheckKey("Step2Shipping")</h5>
                                    </div>
                                    <div class="card-body">
                                        <p>@sharedRes.CheckKey("SendProductTo"):</p>
                                        <address>
                                            <strong>Gianna Shoes d.o.o.</strong><br>
                                            Samoborska cesta 145<br>
                                            10000 Zagreb<br>
                                            @sharedRes.CheckKey("Croatia")
                                        </address>
                                        <p class="small text-muted">@sharedRes.CheckKey("CustomerPaysShipping")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 text-warning mb-3">@sharedRes.CheckKey("Refund")</h2>
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead class="table-warning">
                                    <tr>
                                        <th>@sharedRes.CheckKey("PaymentMethod")</th>
                                        <th>@sharedRes.CheckKey("RefundTime")</th>
                                        <th>@sharedRes.CheckKey("Notes")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@sharedRes.CheckKey("CreditCard")</td>
                                        <td>@sharedRes.CheckKey("5to10WorkingDays")</td>
                                        <td>@sharedRes.CheckKey("RefundToSameCard")</td>
                                    </tr>
                                    <tr>
                                        <td>PayPal</td>
                                        <td>@sharedRes.CheckKey("2to3WorkingDays")</td>
                                        <td>@sharedRes.CheckKey("RefundToPayPal")</td>
                                    </tr>
                                    <tr>
                                        <td>@sharedRes.CheckKey("BankTransfer")</td>
                                        <td>@sharedRes.CheckKey("3to5WorkingDays")</td>
                                        <td>@sharedRes.CheckKey("ToSameAccount")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="alert alert-success">
                            <strong>@sharedRes.CheckKey("WeGuarantee"):</strong> @sharedRes.CheckKey("RefundGuarantee")
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 text-warning mb-3">@sharedRes.CheckKey("Exceptions")</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <h5 class="text-danger">@sharedRes.CheckKey("CannotBeReturned"):</h5>
                                <ul class="text-danger">
                                    <li>@sharedRes.CheckKey("FootwearWornOutside")</li>
                                    <li>@sharedRes.CheckKey("ProductsWithSignsOfUse")</li>
                                    <li>@sharedRes.CheckKey("DamagedProductsNonManufacturer")</li>
                                    <li>@sharedRes.CheckKey("ProductsWithoutPackaging")</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h5 class="text-success">@sharedRes.CheckKey("SpecialCases"):</h5>
                                <ul class="text-success">
                                    <li>@sharedRes.CheckKey("SizeErrorFreeExchange")</li>
                                    <li>@sharedRes.CheckKey("DamageInTransitFullRefund")</li>
                                    <li>@sharedRes.CheckKey("ManufacturerDefectFullRefund")</li>
                                </ul>
                            </div>
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 text-warning mb-3">@sharedRes.CheckKey("ComplaintsAndWarranty")</h2>
                        <div class="card border-warning">
                            <div class="card-body">
                                <h5 class="card-title">@sharedRes.CheckKey("ProductWarranty")</h5>
                                <p class="card-text">@sharedRes.CheckKey("WarrantyDescription"):</p>
                                <ul>
                                    <li><strong>@sharedRes.CheckKey("6Months")</strong> - @sharedRes.CheckKey("MaterialAndWorkmanship")</li>
                                    <li><strong>@sharedRes.CheckKey("2Years")</strong> - @sharedRes.CheckKey("LegalWarranty")</li>
                                    <li><strong>@sharedRes.CheckKey("Lifetime")</strong> - @sharedRes.CheckKey("SupportAndAdvice")</li>
                                </ul>
                                <p class="mb-0"><strong>@sharedRes.CheckKey("Note"):</strong> @sharedRes.CheckKey("WarrantyExclusions")</p>
                            </div>
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 text-warning mb-3">@sharedRes.CheckKey("FAQ")</h2>
                        <div class="accordion" id="faqAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="faq1">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1">
                                        @sharedRes.CheckKey("FAQQuestion1")
                                    </button>
                                </h2>
                                <div id="collapse1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                    <div class="accordion-body">
                                        @sharedRes.CheckKey("FAQAnswer1")
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="faq2">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2">
                                        @sharedRes.CheckKey("FAQQuestion2")
                                    </button>
                                </h2>
                                <div id="collapse2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                    <div class="accordion-body">
                                        @sharedRes.CheckKey("FAQAnswer2")
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="faq3">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3">
                                        @sharedRes.CheckKey("FAQQuestion3")
                                    </button>
                                </h2>
                                <div id="collapse3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                    <div class="accordion-body">
                                        @sharedRes.CheckKey("FAQAnswer3")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                </div>
            </div>
        </div>
    </div>
</div>