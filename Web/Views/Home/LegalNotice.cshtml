@{
    ViewData["Title"] = "Pravno Obavještenje";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentLanguage = ViewData["lang"]?.ToString() ?? "hr";
    var sharedRes = (Dictionary<string, string>)ViewData["Shared"];
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h1 class="h3 mb-0">@sharedRes.CheckKey("LegalNotice")</h1>
                </div>
                <div class="card-body p-4">

                    <section class="mb-5">
                        <h2 class="h4 text-primary mb-3">@sharedRes.CheckKey("CompanyData")</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>@sharedRes.CheckKey("CompanyName"):</strong> Gianna Shoes d.o.o.</p>
                                <p><strong>@sharedRes.CheckKey("RegisteredAddress"):</strong> Samoborska cesta 145, 10000 Zagreb, @sharedRes.CheckKey("Croatia")</p>
                                <p><strong>@sharedRes.CheckKey("RegistrationNumber"):</strong> 04648650</p>
                                <p><strong>@sharedRes.CheckKey("VATNumber"):</strong> HR27743781662</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>@sharedRes.CheckKey("Phone"):</strong> +385 98 996 8721</p>
                                <p><strong>@sharedRes.CheckKey("Email"):</strong> <a href="mailto:hello@nallan.hr">hello@nallan.hr</a></p>
                                <p><strong>@sharedRes.CheckKey("Director"):</strong> Seherezada Azemina Molnár-Saračević</p>
                            </div>
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 text-primary mb-3">@sharedRes.CheckKey("BankAccountData")</h2>
                        <p><strong>@sharedRes.CheckKey("BankName"):</strong> WISE</p>
                        <p><strong>IBAN:</strong> BE85905566111306</p>
                        <p><strong>SWIFT/BIC:</strong> TRWIBEB1XXX</p>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 text-primary mb-3">@sharedRes.CheckKey("TermsOfUse")</h2>
                        <p>@sharedRes.CheckKey("TermsOfUseIntro")</p>

                        <div class="mb-3">
                            <h5>@sharedRes.CheckKey("ProductsAndServices")</h5>
                            <p>@sharedRes.CheckKey("ProductsAndServicesDesc")</p>
                        </div>

                        <div class="mb-3">
                            <h5>@sharedRes.CheckKey("OrdersAndPayment")</h5>
                            <p>@sharedRes.CheckKey("OrdersAndPaymentDesc")</p>
                        </div>

                        <div class="mb-3">
                            <h5>@sharedRes.CheckKey("Delivery")</h5>
                            <p>@sharedRes.CheckKey("DeliveryDesc")</p>
                        </div>

                        <div class="mb-3">
                            <h5>@sharedRes.CheckKey("ReturnsAndRefunds")</h5>
                            <p>@sharedRes.CheckKey("ReturnsAndRefundsDesc")</p>
                        </div>

                        <div class="mb-3">
                            <h5>@sharedRes.CheckKey("Liability")</h5>
                            <p>@sharedRes.CheckKey("LiabilityDesc")</p>
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 text-primary mb-3">@sharedRes.CheckKey("PrivacyRules")</h2>
                        <p>@sharedRes.CheckKey("PrivacyRulesIntro")</p>

                        <div class="mb-3">
                            <h5>@sharedRes.CheckKey("DataCollection")</h5>
                            <p>@sharedRes.CheckKey("DataCollectionDesc")</p>
                        </div>

                        <div class="mb-3">
                            <h5>@sharedRes.CheckKey("DataUsage")</h5>
                            <p>@sharedRes.CheckKey("DataUsageDesc")</p>
