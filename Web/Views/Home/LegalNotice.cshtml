                            <p>@sharedRes.CheckKey("DataSecurityDesc")</p>
                        </div>

                        <div class="mb-3">
                            <h5>@sharedRes.CheckKey("Cookies")</h5>
                            <p>@sharedRes.CheckKey("CookiesDesc")</p>
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 text-primary mb-3">@sharedRes.CheckKey("DisputeResolution")</h2>
                        <p>@sharedRes.CheckKey("DisputeResolutionDesc")</p>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 text-primary mb-3">@sharedRes.CheckKey("ApplicableLaw")</h2>
                        <p>@sharedRes.CheckKey("ApplicableLawDesc")</p>
                    </section>

                    <section class="mb-4">
                        <h2 class="h4 text-primary mb-3">@sharedRes.CheckKey("ContactUs")</h2>
                        <p>@sharedRes.CheckKey("ContactUsDesc")</p>
                        <p><strong>@sharedRes.CheckKey("Email"):</strong> <a href="mailto:hello@nallan.hr">hello@nallan.hr</a></p>
                        <p><strong>@sharedRes.CheckKey("Phone"):</strong> +385 98 996 8721</p>
                        <p><strong>@sharedRes.CheckKey("PostalAddress"):</strong> Samoborska cesta 145, 10000 Zagreb, @sharedRes.CheckKey("Croatia")</p>
                    </section>

                    <div class="alert alert-info">
                        <small>@sharedRes.CheckKey("LastUpdatedLabel"): @DateTime.Now.ToString("dd.MM.yyyy")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>